{
  "manifest_version": 3,
  "name": "Pointer Notes",
  "version": "0.1.0",
  "description": "Click any element on a page, leave a note, and copy structured markdown (selectors, React components, styles) for AI coding agents.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Toggle Pointer Notes (Alt+Shift+A)",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A", "mac": "Alt+Shift+A" },
      "description": "Toggle Pointer Notes"
    }
  }
}
